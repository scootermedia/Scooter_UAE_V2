# Cloudflare static-assets headers (same rules the site used on Netlify)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# CSS and JS are versioned with ?v= in the HTML, so they can be cached for a year
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Images and video may be replaced under the same name: cache a day, then revalidate
/assets/img/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/video/*
  Cache-Control: public, max-age=86400, must-revalidate
